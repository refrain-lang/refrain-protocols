// SMR spindle up-training - 12-16 Hz sensorimotor spindles, one declared delay.
//
// A structural copy of smr.refrain (read its header for the shared design:
// `site` placement, `threshold_style` mode, paired band-edge controls, the
// `artifact_guard` mode, amp-portable reference). This file changes only what
// the spindle design needs, and each change has a reason:
//
//   - EVERY envelope is a single `band_envelope(band:, latency:)` stage, not
//     the four-stage bandpass -> hilbert -> magnitude -> smooth chain. The
//     four-stage chain's delay is the sum of four filters nobody chose
//     (~566 ms on a narrow SMR band); `band_envelope` makes the delay a
//     number in the source. This file is not in test_declared_latency.py's
//     WAITING list, so it must stay a bare `band_envelope` everywhere.
//   - SMR band is 12-16 Hz (smr.refrain: 12-15). Settled by measurement, not
//     literature: 11-16 is the worst option (its alpha shoulder is 2.2x denser
//     than the core); 12-17 is 20 ms faster, inside the sweep's own step, for
//     twice the contamination.
//   - The SMR latency is the one declared delay exposed as a control
//     (`smr_latency`, 320 ms, `live_tunable = false`: it bakes into the
//     filter at resolve time, like the band edges). 320 ms is not a margin
//     over the floor, it is the measured WORST CASE across the replay corpus.
//     At 12-16 Hz the recordings matched the four-stage chain's accuracy
//     somewhere between 240 and 320 ms, median 280; the recording that needs
//     320 is `c008-edf-previous-provider-ec`, the quietest in the corpus at
//     5.6 uV SD, so a legitimately hard low-amplitude case and not a broken
//     one. One file carries one declared latency and it bakes at resolve
//     time, so a median default would train whoever needs more than the
//     median on an envelope LESS accurate than the chain this file replaced.
//     40 ms over the median degrades nobody IN THE CORPUS, and the corpus is
//     as far as the measurement reaches: the eleven recordings of fourteen
//     that were usable (one flat, two carrying impulsive artifact, excluded
//     and reported), four minutes each, none of those subjects performing
//     this task. It is not a general property of the filter. Do not tighten it
//     to 280 without re-measuring the spread
//     (tools/measure_spindle_front_end.py holds the median in its `AT`
//     table).
//     The other three delays are literals in their `band_envelope` calls,
//     each at or above its own band's floor, 1000 / bandwidth ms:
//         theta     4-7  Hz  floor 334 ms   declared 340 ms
//         low band  8-12 Hz  floor 250 ms   declared 320 ms
//         high-beta 16-30 Hz floor  72 ms   declared 320 ms (for stability,
//                                                            see below)
//     HAZARD, and nothing in the stack catches it: NARROWING a band raises
//     its floor. 250 ms is the floor only at the SMR band's default 4 Hz
//     width. A practitioner who narrows to 12-14 Hz has a 500 ms floor, and
//     every value `smr_latency` will accept is then SUB-floor - its range
//     bottoms out at 250 ms - so the envelope becomes less accurate than the
//     four-stage chain this file replaced, silently. The library's floor gate
//     (tests/test_declared_latency.py::_floor_violation) reads each control's
//     declared DEFAULT, never the value a session runs with, so it cannot see
//     a narrowed band. The band-edge controls also carry independent
//     (1 Hz, 45 Hz) ranges, inherited from smr.refrain, so `lo > hi` and a
//     0.5 Hz band are both reachable. If the band becomes narrowable in
//     earnest, the floor has to be enforced at resolve time, not here.
//   - A new LOW-BAND (8-12 Hz) inhibit. The alpha shoulder sits directly
//     below the SMR band and leaks into it; the reward is withheld while that
//     rhythm is high, so alpha/mu activity is not rewarded as spindle.
//   - High-beta band starts at 16 Hz (smr.refrain: 20 Hz) so the veto's lower
//     edge meets the reward band's upper edge with nothing open between. The
//     shipped 20 Hz leaves 16-20 Hz unwatched.
//   - High-beta MUTES; it does not withhold. smr.refrain makes high-beta a
//     `below` term inside the reward conjunction, so a high-beta burst
//     silently resets the dwell. Here it is an `inhibit "hbeta"` with a
//     `mute(release: 200 ms)` action, the same arrangement as the EMG guard:
//     the output goes quiet while it is high and comes back 200 ms after as
//     declared - nearer 300 ms as the recorder delivers it, see the KNOWN
//     LIMITATION note - and the dwell is not what pays for it. The release is
//     left at 200 ms for that reason: `_GAIN_RELEASE_TAU_S = 0.30` dominates
//     it, so declaring less buys almost nothing until that is fixed.
//     That is why there is no `hbeta_t` threshold: an inhibit takes its own
//     literal `percentile(...)` fed by `hbeta_inhibit_rate`, so a shared
//     threshold would be a dead declaration.
//     COST: that literal cannot take the `threshold_style` switch, so the
//     high-beta guard is percentile-only in BOTH modes. In "baseline" mode the
//     other three bands sit at fixed operator-set microvolt values while this
//     one keeps chasing a 2-minute rolling percentile.
//     MUTED TIME IS NOW MEASURED, and there is more of it than this file used
//     to admit, because theta and the low band mute as well as pausing the
//     hold. On the engine replay the four inhibits mute roughly a third of
//     block time between them (medians: theta 19.0%, low band 14.3%,
//     high-beta 4.8%, EMG 3.4%, overlapping). The same run reports 66.3% of
//     its window muted and only 6.8% of it as reward the trainee could HEAR,
//     but do not read those two as session figures: the replay window is four
//     minutes long and the session's two-minute `warmup` phase mutes 49.1% of
//     it by design, where in a real session warmup is two minutes of thirty.
//     Separating block-only audible time from phase-muted time needs a
//     phase-aware measurement this tool does not do yet.
//     MUTED TIME IS THE FIGURE TO WATCH, in both modes including the default
//     adaptive one, because the tone is the one thing this protocol delivers
//     earlier than smr.refrain and a mute is what takes it away. Two parts to
//     it, and only the first is knowable from the source. STRUCTURAL: a
//     rolling percentile at target P is above itself (100 - P)% of samples by
//     construction, whatever the trainee does, so at the 95 default the raw
//     crossing rate is about 5% and at 50 it would be half the session. That
//     is a property of the threshold, not of the signal. NOT KNOWN HERE: how
//     much `mute(release: 200 ms)` inflates that, because it depends on how
//     the real high-beta envelope's excursions cluster in time, and because
//     the release is delivered at roughly 300 ms rather than 200 (see the
//     KNOWN LIMITATION note below). No number in this file is a measured
//     muted fraction on real EEG; the corpus replay gate reports muted time
//     alongside reward time and settles it. Until it does, read muted time as
//     unmeasured rather than small. The asymmetry that makes this worth
//     checking: reward events are logged while the output is muted, so a
//     debrief can count rewards the trainee never heard.
//     The default is 95 - the loosest the control allows, and the same place
//     the EMG guard's `artifact_strictness` sits - because a guard that takes
//     the SOUND away should fire on something rare, and with a percentile
//     threshold how often it fires is set by the percentile, not by the
//     trainee. At 75 it would mute AT LEAST a quarter of every block by
//     construction on a perfectly clean recording - a quarter is the raw
//     crossing rate, and the release only adds to it. That it is looser than
//     theta (80) and low band (85) is deliberate, and the opposite way round
//     from smr.refrain, where 75 governed a conjunction veto that cost one
//     reward: those two withhold a reward, this one silences the channel
//     that carries the whole latency improvement, so it has to be the most
//     reluctant of the three, not the quickest.
//   - The high-beta envelope declares 320 ms for STABILITY, not speed - the
//     only envelope in this file where that is the right trade, and the one
//     place "faster is better" is wrong. Everywhere else a declared latency
//     is how long the trainee waits for feedback. This one feeds a mute,
//     where the failure mode is not lateness but twitchiness: the lighter the
//     smoothing, the more often the estimate crosses its own threshold and
//     the more often the sound cuts out. 120 ms sat well above the wide
//     band's 72 ms floor and was the lightest smoothing in the file, which
//     made the one guard that silences audio the twitchiest signal in it.
//     320 ms asks for a sustained excursion instead, and matches the SMR
//     path, so the mute responds to contamination that lasts rather than to
//     every flicker. A mute arriving a fifth of a second later costs little;
//     a mute chattering costs the tone.
//   - THETA AND THE LOW BAND ARE INHIBITS LABELLED `kind = "artifact"`, not
//     terms inside the reward conjunction. In the conjunction a dip in either
//     one resets the dwell, and a 500 ms criterion then almost never
//     completed. Measured over the twelve-recording replay corpus: SMR alone
//     is above its own threshold 61.0% of the time, theta or the alpha
//     shoulder is high 30.3% of the time, and all three conditions held
//     CONTINUOUSLY for 500 ms only 1.3% of it - against a design target of
//     25-40%. As artifact inhibits those samples are scored as neither
//     success nor failure: refrain's dwell checks observability BEFORE it
//     looks at the condition, so the streak and the dip counter both freeze,
//     and the reward reads "500 ms of observable SMR" with contamination
//     pausing the clock rather than restarting it. That restructuring alone
//     carries most of the gain - 5.9% at zero tolerance, before any dip is
//     forgiven.
//     TWO MEASUREMENT BASES, and they differ by about three points, so do not
//     mix them. The sweep that PICKED these numbers ran a transcription of
//     refrain v0.25.1's `DwellImpl.step` over the corpus envelopes, which is
//     cheap enough to sweep twelve variants. The chosen variant was then
//     replayed through the REAL evaluator, which is the figure to quote: 27.8%
//     median reward time (n=13), 10.7 reward onsets per minute, against the
//     transcription's 30.7%. The marginals agree closely - SMR above its
//     threshold 60.7% on the engine against 61.0% transcribed - so the gap is
//     in the hold, not in the signal path, and it runs in the conservative
//     direction. Both figures sit inside the 25-40% target band; a tolerance
//     BELOW 120 ms would not, once the three points are taken off.
//     TWO COSTS, both real, neither measurable away.
//     (1) Theta and the alpha shoulder STOP BEING HARD VETOES. A spindle
//     during mild contamination can now eventually pay out, where before the
//     reward was blocked outright. If either has to be an absolute veto, the
//     shape to use instead is the three-term conjunction with a ~300 ms
//     tolerance (33.9% reward time on the same corpus) - which forgives
//     genuine sub-threshold SMR along with the contamination, and forgives
//     most of a 500 ms criterion. That is a signal-definition choice, not a
//     measurement one.
//     (2) NEITHER GUARD CAN TAKE THE `threshold_style` SWITCH any more. An
//     inhibit's threshold must be a literal constructor call (resolver.py
//     `_resolve_inhibit`), and choosing between `absolute(...)` and
//     `percentile(...)` is a choice at the top level, not inside an argument
//     where it could be folded. So the two inhibit-band thresholds and their
//     two baseline-mode microvolt controls are GONE rather than left as
//     declarations nothing reads: in "baseline" mode only the SMR reward
//     threshold becomes an operator-set microvolt value, and all three guards
//     keep chasing 2-minute rolling percentiles - the asymmetry the high-beta
//     guard already had, now shared by all three. What that loses is
//     specific: a rolling percentile cannot see a SUSTAINED elevation by
//     construction, because a trainee who is drowsy throughout still has to
//     beat their own 80th percentile to trip the theta guard, and the
//     absolute thresholds were the one configuration that could. Restoring
//     them takes two inhibits per band, each pinned harmless in the other
//     mode by folding the switch into an ARGUMENT the way `artifact_guard` is
//     folded into the EMG guard's `target_pct`. Not done here: it doubles the
//     guard count on a protocol that has never been trialled, and the default
//     mode is adaptive.
//   - THE DWELL FORGIVES A DIP OF UP TO 120 ms (`tolerance:`, refrain
//     v0.25.0). Forgive, don't credit: a forgiven sample never advances the
//     streak, so a completed hold is always 500 ms genuinely above threshold
//     and the wall-clock span it took is longer - 712 ms median on the corpus.
//     120 ms sits on a plateau, not a knife edge: transcribed, 110 ms rewards
//     28.5% of the block, 120 ms 30.7%, 130 ms 32.4% and 140 ms 36.2%, so
//     +-20 ms stays inside the 25-40% band even after the engine's three
//     points come off the top. It is a LITERAL and not a control, for the same
//     reason `spindle_duration` is resolve-time: `DwellImpl` bakes
//     `tolerance_samples` in its constructor and has no `update_control`
//     hook, so a live change would be silently discarded. It also ROUNDS to
//     samples, and upstream deliberately does not floor it at one - at 256 Hz
//     120 ms is 31 samples, while anything under about 2 ms rounds to zero and
//     forgives nothing, which is what such a declaration asked for.
//   - Spindle duration is the control `spindle_duration`, default 500 ms: the
//     published minimum for a spindle (AASM, >= 0.5 s). smr.refrain's 250 ms
//     is a reaction-time dwell, not a spindle criterion. Range 250-1500 ms.
//
//   - Evidence tier is "exploratory", not smr.refrain's "established". That
//     tier rests on the Sterman/Lubar SMR recipe, and this is a different
//     configuration: 12-16 Hz reward, an added 8-12 Hz inhibit, a 16 Hz
//     high-beta edge, a spindle-length dwell. It is assembled from our own
//     measurements and published spindle criteria and has never been trialled
//     as a whole. The citation covers only the lineage (spindle conditioning),
//     not this band or criterion.
//   - TWO feedback channels, not one. smr.refrain gates its tone on the reward
//     holding (`audio_gain = reward.event.holds ? reward.continuous : 0`), so
//     the tone and the ding fire at the same instant and there is really only
//     one feedback moment. Here the tone is ungated
//     (`audio_gain = reward.continuous`) and carries no duration criterion, so
//     it arrives about 500 ms earlier than the ding: the spindle_duration
//     default. That is how this protocol's latency improvement reaches the
//     trainee. The ding (`audio_chime = reward.event`) then marks "that was a
//     real spindle" on the published 500 ms criterion. End-to-end figures
//     depend on the amp and the speakers and live with the recorder, not
//     here: see recorder/docs/feedback-latency-measurement.md section 9. Both
//     inhibits MUTE: an ungated tone tracks raw amplitude, so without the
//     mutes a jaw clench would become a loud tone, the inverse of the
//     contingency.
//   - KNOWN LIMITATION, as delivered: the renderer smooths the tone
//     asymmetrically. recorder/backend/feedback/audio_renderer.py:125-126 sets
//     _GAIN_ATTACK_TAU_S = 0.05 and _GAIN_RELEASE_TAU_S = 0.30, so the release
//     time constant is 6x the attack. Downward movements of the tone therefore
//     arrive about 250 ms later than upward ones (0.30 s - 0.05 s),
//     independent of everything upstream. Two consequences, worse for
//     spindles than for a sustained amplitude: it blurs the end of every burst
//     (against a 562 ms median burst, from the replay corpus episode
//     statistics, the gain is still near 15% of peak, exp(-562/300), when the
//     burst has been over for as long as it lasted, so the tone trails into
//     the silence); and it is a one-sided low-pass on the shaping signal, so
//     "you are losing it" reaches the trainee later than "you are getting
//     it", and that is the half a trainee needs to learn what not to do. The
//     shipped protocol hides this because its tone is gated, so the release
//     only shapes the tail of an already-finished reward; an ungated tone runs
//     through it continuously. The fix is not in this repository: make the
//     smoothing a property of the gain source (fast and symmetric for a
//     continuous channel, asymmetric as now for a reward-gated one), as
//     recorder/docs/feedback-latency-measurement.md section 9 describes. A
//     module-level retune would bring back the warble the 0.30 s release was
//     added to remove, and THIS PROTOCOL IS NOT EXEMPT FROM THAT WARBLE.
//     The warble is a gate toggling the gain (audio_renderer.py:120-124).
//     Ungating the tone removes the REWARD gate, not the mechanism: both
//     inhibits `mute`, and refrain drives `audio_gain` to exactly 0.0 through
//     a mute (`np.where(muted, 0.0, clamped)` in its eval_.py), so the mute
//     is a second gate on the same value - driven by the guards instead of by
//     the reward, and able to pump the gain the same way. That is the
//     stronger reason the fix belongs on the gain source rather than in the
//     module constant: a continuous channel needs a release that is fast AND
//     symmetric, which means whoever builds one has to keep the pumping
//     protection and move it onto the MUTE transition. A gain source that
//     simply drops the asymmetry would hand a fast symmetric release a value
//     that still gates to zero whenever a guard trips.
//   - COVERAGE, so nobody reads green CI as behavioural evidence: the repo's
//     behavioural gate does not cover this file. `refrain fuzz` classifies a
//     reward signal by looking for bandpass SOS coefficients
//     (refrain/fuzz/surface.py:453); a `band_envelope` derive has none, so
//     the protocol is reported SKIPPED (unsupported: non-bandpass (coherence)
//     reward signal) - a reason that names the wrong cause, there is no
//     coherence here - and a typed skip does not fail the build. Verified at
//     refrain v0.24.0: this file SKIPs where smr.refrain and
//     high_beta_down.refrain both PASS. So this protocol's only automated
//     coverage is the structural IR assertions in tests/test_smr_spindle.py:
//     nothing checks that the engine behaves the way this header says it
//     does. It is not specific to this file either - every protocol that
//     migrates to `band_envelope` leaves that gate the same way.
//
// Research Use Only.

protocol "smr_spindle" {

  meta {
    version           = "1.0.0"
    evidence          = "exploratory"
    description       = "SMR spindle (12-16 Hz) up-training on declared-latency envelopes - practitioner-selected site, bands, and thresholds"
    title             = "SMR spindle training"
    summary           = "Rewards 12-16 Hz sensorimotor spindles while inhibiting theta, the 8-12 Hz band and high-beta, at a chosen site, with adaptive or baseline-fixed thresholds."
    family            = "smr_spindle"
    threshold_style   = "selectable"
    status            = "draft"
    modality          = "eeg"
    goals             = ["focus_attention", "sleep_quality"]
    author            = "Peak Mind"
    citation          = "Wyrwicka W. & Sterman M.B. (1968), conditioning of sensorimotor spindles; the band, criterion and inhibits here are not from that work"
    control_ref       = "library/operant/smr_sham@1.0"
    advanced_controls = [
      "site",
      "smr_lo_hz", "smr_hi_hz",
      "theta_lo_hz", "theta_hi_hz",
      "low_lo_hz", "low_hi_hz",
      "hbeta_lo_hz", "hbeta_hi_hz",
      "smr_latency", "spindle_duration",
      "theta_inhibit_rate", "low_inhibit_rate", "hbeta_inhibit_rate",
      "artifact_guard", "artifact_strictness",
      "smr_threshold_uv",
    ]
  }

  requires {
    coupling    = "ac"
    sample_rate = ">= 250 Hz"
    impedance   = "not_required"
    markers     = "not_required"
  }


  // The chosen site substitutes here; reference resolves per the connected
  // amp's profile, not a hardcoded scheme.
  input "raw" {
    montage = referential(active: site, reference: amp.reference)
  }

  derive "smr_envelope" {
    from = "raw"
    pipeline = [
      band_envelope(band: (smr_lo_hz, smr_hi_hz), latency: smr_latency),
    ]
  }

  derive "theta_envelope" {
    from = "raw"
    pipeline = [
      band_envelope(band: (theta_lo_hz, theta_hi_hz), latency: 340 ms),
    ]
  }

  // Low-band (8-12 Hz) guard - the alpha shoulder directly below the SMR band.
  derive "low_envelope" {
    from = "raw"
    pipeline = [
      band_envelope(band: (low_lo_hz, low_hi_hz), latency: 320 ms),
    ]
  }

  // --- STAGE 2 PROBE: the waxing trigger ---------------------------------
  // The measured winner was `(env > 0.8 * target) & (slope > 0)` with a 1 s
  // refractory. Neither half inlines: `above()` wants a stream_ref and a
  // threshold-or-number, so the scaling and the slope each need a derive.
  derive "smr_slope" {
    from = "smr_envelope"
    pipeline = [
      differentiate(),
      smooth(tau: 100 ms),
    ]
  }

  // High-beta artifact/arousal guard - EMG bleed and hyperarousal. 320 ms is
  // chosen for STABILITY, not speed: it feeds a mute, and the wide band's
  // 72 ms floor would let this be the twitchiest signal in the file. See the
  // header.
  derive "high_beta_envelope" {
    from = "raw"
    pipeline = [
      band_envelope(band: (hbeta_lo_hz, hbeta_hi_hz), latency: 320 ms),
    ]
  }

  // SMR reward threshold — an adaptive percentile of the trainee's own
  // signal by default; a baseline-fixed absolute µV value when
  // `threshold_style` is switched to "baseline" (seeded from the live
  // signal so the switch isn't a cold start).
  threshold "smr_t" {
    signal       = "smr_envelope"
    type         = threshold_style == "baseline"
                     ? absolute(value: smr_threshold_uv)
                     : percentile(target_pct: smr_reward_pct, window: 2 min)
    live_tunable = true
  }

  // EMG artifact guard — muscle (jaw/neck) shows up 50-100 Hz. `artifact_guard`
  // toggles the guard on/off; refrain's inhibit resolver requires `threshold`
  // to be a literal constructor call (no top-level mode fold there, unlike
  // threshold.type above), so on/off is folded one level down, inside the
  // `target_pct` ARGUMENT: "on" uses the tunable `artifact_strictness`
  // percentile floor a burst must cross before muting; "off" pins it to 100
  // (the window's own historical max), which in practice never trips.
  inhibit "emg" {
    metric    = bandpower(input: "raw", band: (50 Hz, 100 Hz), window: 100 ms)
    threshold = percentile(
      target_pct: artifact_guard == "on" ? artifact_strictness : 100,
      window: 2 min
    )
    action    = mute(release: 200 ms)
  }

  // High-beta guard - mutes the output rather than gating the reward (see
  // header). The threshold must be a literal constructor call; its own rate
  // control keeps it independent of the theta and low-band vetoes.
  //
  // WHY `linear(..., midpoint: 0 uV, slope: 1)` AND NOT `passthrough`. An
  // inhibit's metric must be a primitive call, so a guard that watches an
  // existing derive needs some primitive to carry it through - reading the
  // declared-latency envelope rather than adding a second bandpower stage with
  // its own unchosen delay. This file used `passthrough(input: ...)` and called
  // it refrain's documented form for that. BOTH HALVES OF THAT WERE WRONG.
  // `PassthroughImpl`'s own docstring calls it a "first-class identity
  // MONTAGE" that "requires exactly one source channel" - it is the sanctioned
  // replacement for the `referential(reference: "device")` workaround, not a
  // compute node. And `refrain-core` never implemented it as one: its compute
  // dispatch ends `other => panic!("PoC: unsupported compute primitive")`, and
  // `passthrough` appears in that crate only as a montage. The Python resolver
  // accepts it because it checks only that the metric IS a call.
  // So the protocol ran on the Python reference backend and FAILED TO START on
  // the Rust one - and the recorder resolves its default `auto` to Rust
  // whenever the wheel is importable, which it is, so this protocol could not
  // have run a session. Measured: 46 of the 47 protocols in this library build
  // and step on both backends; this was the one that did not.
  // `linear(x, midpoint, slope)` is an affine map, so slope 1 about 0 is the
  // identity, and Rust implements it. Verified bit-identical, not assumed. On
  // one recording, same chunking: `reward.event.holds` and `muted` hash
  // identical between the two metrics on Python AND between Python and Rust
  // with this metric, while `output/audio_gain` differs by at most 8.3e-15 -
  // last-bit rounding in the sigmoid, on the continuous tone value and not on
  // the reward or the gate. Then over the whole twelve-recording corpus on the
  // RUST backend: 27.8% reward time, 6.8% audible, 65.8% silent, 10.7 onsets
  // per minute, theta muting 19.0% and the low band 14.3% - every figure
  // identical to the Python replay of the `passthrough` version. So the
  // numbers in this header are production-backend numbers, and the metric
  // change moved none of them.
  // The proper fix is upstream - either implement `passthrough` as a compute
  // primitive in refrain-core, or give the language a way for an inhibit to
  // name a derive directly. Revert this to whichever lands.
  // The idiom still costs the editor: a wrapped derive is the one shape here
  // that catalog v1's matcher cannot read (see tests/test_corpus_roundtrip.py's
  // KNOWN_GAPS entry), and that is unchanged by which primitive wraps it.
  // 95 is the loosest the rate control allows, on purpose: this is the guard
  // that takes the SOUND away, and a percentile decides how often it fires
  // regardless of the signal. See the header.
  inhibit "hbeta" {
    metric    = linear("high_beta_envelope", midpoint: 0 uV, slope: 1)
    threshold = percentile(target_pct: hbeta_inhibit_rate, window: 2 min)
    action    = mute(release: 200 ms)
  }

  // Theta and low-band guards - the two that used to be `below` terms inside
  // the reward conjunction. `kind = "artifact"` is what makes the move worth
  // making: it tells the engine these samples are UNOBSERVABLE rather than
  // failed, so the dwell freezes its streak and its dip counter instead of
  // resetting them. Without the label a contaminated stretch longer than the
  // tolerance would reset the streak through the dip path and the move would
  // buy nothing. Percentile-only in both threshold styles - see the header's
  // second cost. The `linear(..., slope: 1)` identity is how a guard reads an
  // existing derive at all; the header says why it is not `passthrough`.
  inhibit "theta" {
    metric    = linear("theta_envelope", midpoint: 0 uV, slope: 1)
    threshold = percentile(target_pct: theta_inhibit_rate, window: 2 min)
    action    = flag()
    kind      = "artifact"
    exempt    = ["audio_chime"]
  }

  inhibit "low" {
    metric    = linear("low_envelope", midpoint: 0 uV, slope: 1)
    threshold = percentile(target_pct: low_inhibit_rate, window: 2 min)
    action    = flag()
    kind      = "artifact"
    exempt    = ["audio_chime"]
  }

  reward {
    event = dwell(
      condition: above("smr_envelope", "smr_t"),
      duration: spindle_duration,
      tolerance: 120 ms
    )
    continuous = sigmoid("smr_envelope" / "smr_t",
                         midpoint: 1.0, steepness: 3)
  }

  output {
    audio_chime = dwell(
      condition: all_of([
        above("smr_envelope", __BAR__ uV),
        above("smr_slope", 0),
      ]),
      duration: 4 ms
    )
    audio_gain  = reward.continuous
  }

  controls {
    // --- Basic: the only two controls NOT listed in advanced_controls ---
    threshold_style = mode {
      choices = ["adaptive", "baseline"]
      default = "adaptive"
      label   = "Threshold style"
    }
    smr_reward_pct = percent {
      default      = 40
      range        = (15, 70)
      label        = "SMR reward rate"
      live_tunable = true
    }

    // --- Advanced: site ---
    site = placement {
      kind    = "active"
      default = "Cz"
      label   = "Training site"
    }

    // --- Advanced: band edges (resolve-time only — see header) ---
    smr_lo_hz = frequency {
      default      = 12 Hz
      range        = (1 Hz, 45 Hz)
      label        = "SMR band low edge"
      live_tunable = false
    }
    smr_hi_hz = frequency {
      default      = 16 Hz
      range        = (1 Hz, 45 Hz)
      label        = "SMR band high edge"
      live_tunable = false
    }
    theta_lo_hz = frequency {
      default      = 4 Hz
      range        = (1 Hz, 45 Hz)
      label        = "Theta inhibit band low edge"
      live_tunable = false
    }
    theta_hi_hz = frequency {
      default      = 7 Hz
      range        = (1 Hz, 45 Hz)
      label        = "Theta inhibit band high edge"
      live_tunable = false
    }
    low_lo_hz = frequency {
      default      = 8 Hz
      range        = (1 Hz, 45 Hz)
      label        = "Low-band inhibit low edge"
      live_tunable = false
    }
    low_hi_hz = frequency {
      default      = 12 Hz
      range        = (1 Hz, 45 Hz)
      label        = "Low-band inhibit high edge"
      live_tunable = false
    }
    hbeta_lo_hz = frequency {
      default      = 16 Hz
      range        = (1 Hz, 45 Hz)
      label        = "High-beta inhibit band low edge"
      live_tunable = false
    }
    hbeta_hi_hz = frequency {
      default      = 30 Hz
      range        = (1 Hz, 45 Hz)
      label        = "High-beta inhibit band high edge"
      live_tunable = false
    }

    // --- Advanced: SMR envelope delay (resolve-time only - see header) ---
    smr_latency = duration {
      default      = 320 ms
      range        = (250 ms, 600 ms)
      label        = "SMR envelope latency"
      live_tunable = false
    }

    // --- Advanced: spindle duration (resolve-time only) ---
    // Bakes into the dwell when the protocol starts, like the band edges: the
    // plain `dwell(...)` the reward must use (DwellImpl) computes its sample
    // count once in __init__ and has no `update_control` hook, so a live
    // change would be silently discarded. DwellRearmImpl and HoldForImpl do
    // carry that hook; if this is ever wanted live, the upstream fix is to
    // copy it onto DwellImpl. (Still absent at refrain v0.25.1, which added
    // `tolerance` to the same primitive without adding the hook; not done here.)
    // Kept in `advanced_controls` with the band edges and smr_latency, which
    // are resolve-time too: it is an advanced setting either way.
    spindle_duration = duration {
      default      = 500 ms
      range        = (250 ms, 1500 ms)
      label        = "Spindle duration"
      live_tunable = false
    }

    // --- Advanced: inhibit rates ---
    theta_inhibit_rate = percent {
      default      = 80
      range        = (50, 95)
      label        = "Theta inhibit rate"
      live_tunable = true
    }
    low_inhibit_rate = percent {
      default      = 85
      range        = (50, 95)
      label        = "Low-band inhibit rate"
      live_tunable = true
    }
    hbeta_inhibit_rate = percent {
      default      = 95
      range        = (50, 95)
      label        = "High-beta inhibit rate"
      live_tunable = true
    }

    // --- Advanced: artifact guard ---
    artifact_guard = mode {
      choices = ["on", "off"]
      default = "on"
      label   = "Artifact guard (EMG)"
    }
    artifact_strictness = percent {
      default      = 95
      range        = (50, 99)
      label        = "Artifact guard strictness"
      live_tunable = true
    }

    // --- Advanced: baseline-mode absolute thresholds (seeded) ---
    smr_threshold_uv = voltage {
      default      = 2.0 uV
      range        = (0.5 uV, 10.0 uV)
      label        = "SMR threshold"
      live_tunable = true
      seed = percentile {
        from       = "smr_envelope"
        window     = 60 s
        target_pct = smr_reward_pct
      }
    }
  }

  // Full staged session: the canonical shape per docs/fork-audit-2026-07.md
  // (top-level's mode-toggle + seed + staged session beats a single
  // continuous block). Warmup matches the percentile window (2 min) so the
  // adaptive threshold buffer is fully baseline-trained at run start.
  session {
    phases = [
      phase { name = "warmup";   duration = 120 s; output_muted = true },
      phase { name = "block1";   duration = 5 min; mode = timed_with_floor },
      phase { name = "rest1";    duration = 2 min; output_muted = true },
      phase { name = "block2";   duration = 5 min; mode = timed_with_floor },
      phase { name = "rest2";    duration = 2 min; output_muted = true },
      phase { name = "block3";   duration = 5 min; mode = timed_with_floor },
      phase { name = "rest3";    duration = 2 min; output_muted = true },
      phase { name = "block4";   duration = 5 min; mode = timed_with_floor },
      phase { name = "cooldown"; duration = 30 s;  output_muted = true },
    ]
  }
}
