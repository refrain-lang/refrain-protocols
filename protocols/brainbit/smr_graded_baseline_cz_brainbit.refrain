// SMR training at Cz — GRADED BASELINE-FIXED variant (BrainBit Flex).
//
// Companion to smr_graded_cz_brainbit (continuous feedback, adaptive
// anchors) and smr_classic_baseline_cz_brainbit (gated, baseline-fixed
// thresholds). Combines the *smooth* feedback of graded with the *fixed*
// thresholds of baseline mode — ideal for game-driven sessions over OSC
// (race car throttle, lane-keeping, anything where on/off gating would
// stutter the experience).
//
// Why this combination:
//   - audio_gain = reward.composite is ALWAYS-ON (never gated to zero),
//     so an OSC consumer driving a game's throttle/control gets a
//     continuously varying signal — no spotty stutter.
//   - Thresholds (the sigmoid anchors) are seeded from the warmup-period
//     median of each band and held fixed for the run. As the patient
//     improves, reward.composite rises above the anchor (faster car); as
//     they regress, it falls below (slower car). Reward rate becomes the
//     visible/audible feedback signal, not something the engine keeps
//     chasing.
//
// Design choices:
//   - Per-band success = sigmoid(signal / fixed_anchor, midpoint 1.0):
//     0.5 when the band sits at its baseline median, rising/falling
//     smoothly around it. NO drift — the anchor stays where the seed
//     placed it.
//   - reward.composite is a weighted average of SMR-up and theta-down
//     success; audio_gain tracks it directly (always-on graded feedback).
//     A chime still marks sustained good performance (composite > 0.5
//     for 250 ms) for clinicians who want a discrete cue too.
//   - EMG handled as adaptive artifact rejection (muscle distributions
//     are too session-specific to fix from baseline).
//
// Electrode placement: scalp channel #1 at Cz; others unused.

protocol "smr_graded_baseline_cz_brainbit_v1" {

  meta {
    version           = "1.0.0"
    evidence          = "demo"
    description       = "Graded SMR/theta composite at Cz with baseline-fixed anchors (continuous feedback, no drift), BrainBit Flex monopolar"
    title             = "Graded SMR training (top of head)"
    summary           = "BrainBit: always-on graded SMR/theta feedback at the top of the head, with fixed baseline anchors."
    family            = "smr_cz"
    status            = "reviewed"
    goals             = ["adhd_attention"]
    author            = "Peak Mind"
    citation          = "Sterman M.B. & Lubar J.F. (foundational corpus, 1970s-1990s)"
    population        = "children_adults"
    indication        = "ADHD_attention_regulation"
    control_ref       = "library/operant/smr_sham@1.0"
    safety_monitoring = ["pre_session_check", "intra_session_clinician_observation"]
    outcome_measures  = ["IVA-2_continuous_performance", "Conners-3"]
  }

  requires {
    coupling    = "ac"
    sample_rate = ">= 250 Hz"
    channels    = ["Cz"]
    impedance   = "not_required"
    markers     = "not_required"
  }

  input "raw" {
    montage = referential(active: "Cz", reference: "device")
  }

  derive "smr_envelope" {
    from = "raw"
    pipeline = [
      bandpass(band: (12 Hz, 15 Hz), order: 4),
      hilbert(),
      magnitude(),
      smooth(tau: 250 ms),
    ]
  }

  derive "theta_envelope" {
    from = "raw"
    pipeline = [
      bandpass(band: (4 Hz, 8 Hz), order: 4),
      hilbert(),
      magnitude(),
      smooth(tau: 250 ms),
    ]
  }

  // Baseline-fixed anchors — seeded from the warmup-period median (50th
  // percentile) of each band, then held constant for the run. The recorder's
  // baseline_seed handler computes these at warmup→run via set_control. The
  // sigmoid scoring is centred on the anchor (success = 0.5 at signal ==
  // anchor), so a fixed anchor means a stable reward landscape — patient's
  // composite score reflects their drift from the resting baseline, not a
  // moving target.
  threshold "smr_t" {
    signal       = "smr_envelope"
    type         = absolute(value: smr_anchor_uv)
    live_tunable = true
  }

  threshold "theta_t" {
    signal       = "theta_envelope"
    type         = absolute(value: theta_anchor_uv)
    live_tunable = true
  }

  // EMG artifact inhibit — kept adaptive (95th-pct, 2-min window) for the
  // same reason as the other baseline protocols: muscle artifact
  // distributions vary too much session-to-session to baseline-fix.
  inhibit "emg" {
    metric    = bandpower(input: "raw", band: (50 Hz, 100 Hz), window: 100 ms)
    threshold = percentile(target_pct: 95, window: 2 min)
    action    = mute(release: 200 ms)
  }

  // Named composite components — same shape as smr_graded, but the
  // anchors they're scored against are fixed.
  reward  "smr"   { signal = sigmoid("smr_envelope"   / "smr_t",   midpoint: 1.0, steepness: 2); weight = w_smr }
  inhibit "theta" { signal = sigmoid("theta_envelope" / "theta_t", midpoint: 1.0, steepness: 2); weight = w_theta }

  reward {
    combine    = "weighted"
    continuous = reward.composite
    event      = dwell(condition: above(reward.composite, 0.5), duration: 250 ms)
  }

  output {
    // Always-on graded feedback — the OSC consumer / audio renderer gets a
    // continuously varying signal that never gates to zero. Ideal for game
    // control (throttle, lane width, speed) where on/off would stutter.
    audio_gain  = reward.composite
    audio_chime = reward.event
  }

  controls {
    w_smr = percent {
      default      = 1.0
      range        = (0, 4)
      label        = "SMR reward weight"
      live_tunable = true
    }
    w_theta = percent {
      default      = 0.6
      range        = (0, 4)
      label        = "Theta suppress weight"
      live_tunable = true
    }
    // Baseline anchors — seeded at warmup→run from each band's median.
    // Clinician CAN drag mid-session (loosen or tighten the sigmoid centre)
    // as a manual override, but the headline value comes from baseline.
    smr_anchor_uv = voltage {
      default      = 2.0 uV
      range        = (0.5 uV, 10.0 uV)
      label        = "SMR anchor"
      live_tunable = true
    }
    theta_anchor_uv = voltage {
      default      = 5.0 uV
      range        = (1.0 uV, 20.0 uV)
      label        = "Theta anchor"
      live_tunable = true
    }
  }

  session {
    phases = [
      // Warmup sized for the baseline-seed handler: it trims to the last
      // 60s of warmup samples (recorder/backend/nf/baseline_seed.py
      // _SETTLED_WINDOW_S = 60.0) to drop sit-down tension, so 90s gives
      // ~30s settling + 60s of clean samples for the seed. The EMG
      // inhibit's 2-min percentile is then ~75% full at run start, which
      // is fine for an artifact guard.
      phase { name = "warmup";   duration = 90 s; output_muted = true },
      phase { name = "training"; duration = 30 min },
      phase { name = "cooldown"; duration = 30 s;  output_muted = true },
    ]
  }
}
