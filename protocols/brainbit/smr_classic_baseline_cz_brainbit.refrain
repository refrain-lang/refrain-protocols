// SMR operant training at Cz — BASELINE-FIXED Sterman/Lubar variant (BrainBit Flex).
//
// Companion to smr_classic_cz_brainbit.refrain. Same channel, derives,
// inhibit, reward, and output — only the THRESHOLDS differ:
//
//   - Adaptive variant (smr_classic_cz_brainbit): thresholds are a
//     percentile of a 2-min moving window. Reward rate stays ~constant;
//     threshold tracks the patient's recent state.
//   - Baseline variant (this file): thresholds are absolute values seeded
//     from the warmup-period percentile of each derive, then frozen for
//     the run. Threshold stays flat; reward rate goes up when the patient
//     improves and down when they drift. The recorder's baseline_seed
//     handler (recorder/backend/nf/baseline_seed.py) computes the seed
//     at warmup→run and pushes it via set_control.
//
// The voltage controls below carry the (eventually seeded) threshold
// values. The defaults are sensible "what would adaptive give you" placeholders
// that get overwritten at warmup→run for ~all real sessions. Clinician
// can drag the slider mid-session to override (safety valve).
//
// Electrode placement: scalp channel #1 at Cz; others unused.

protocol "smr_classic_baseline_cz_brainbit_v1" {

  meta {
    version           = "1.0.0"
    evidence          = "demo"
    description       = "Classic SMR operant training at Cz with baseline-fixed thresholds (SMR up, loose theta inhibit, EMG artifact rejection), BrainBit Flex monopolar"
    status            = "reviewed"
    goals             = ["adhd_attention"]
    author            = "Peak Mind"
    citation          = "Sterman M.B. & Lubar J.F. (foundational corpus, 1970s-1990s)"
    population        = "children_adults"
    indication        = "ADHD_attention_regulation"
    control_ref       = "library/operant/smr_sham@1.0"
    safety_monitoring = ["pre_session_check", "intra_session_clinician_observation"]
    outcome_measures  = ["IVA-2_continuous_performance", "Conners-3"]
  }

  requires {
    coupling    = "ac"
    sample_rate = ">= 250 Hz"
    channels    = ["Cz"]
    impedance   = "not_required"
    markers     = "not_required"
  }

  // Monopolar Cz — uses the BrainBit's dedicated hardware reference.
  input "raw" {
    montage = referential(active: "Cz", reference: "device")
  }

  derive "smr_envelope" {
    from = "raw"
    pipeline = [
      bandpass(band: (12 Hz, 15 Hz), order: 4),
      hilbert(),
      magnitude(),
      smooth(tau: 250 ms),
    ]
  }

  derive "theta_envelope" {
    from = "raw"
    pipeline = [
      bandpass(band: (4 Hz, 8 Hz), order: 4),
      hilbert(),
      magnitude(),
      smooth(tau: 250 ms),
    ]
  }

  // SMR reward threshold — BASELINE-FIXED. The control's value is seeded
  // from the 40th percentile of the warmup-period SMR envelope (see the
  // recorder's baseline_seed handler).
  threshold "smr_t" {
    signal       = "smr_envelope"
    type         = absolute(value: smr_threshold_uv)
    live_tunable = true
  }

  // Theta INHIBIT threshold — BASELINE-FIXED, seeded at the 80th percentile
  // of warmup-period theta. Loose guard that only blocks reward during
  // genuine drowsy excursions, anchored to the patient's resting state
  // rather than drifting with the moving window.
  threshold "theta_t" {
    signal       = "theta_envelope"
    type         = absolute(value: theta_threshold_uv)
    live_tunable = true
  }

  // EMG artifact inhibit — kept adaptive (95th-percentile of the 50-100 Hz
  // band over a 2-min window). Muscle artifact distributions are too
  // session-specific (jaw clench, neck tension) to fix-from-baseline;
  // adaptive percentile is the right call here.
  inhibit "emg" {
    metric    = bandpower(input: "raw", band: (50 Hz, 100 Hz), window: 100 ms)
    threshold = percentile(target_pct: 95, window: 2 min)
    action    = mute(release: 200 ms)
  }

  reward {
    event = dwell(
      condition: all_of([
        above("smr_envelope",   "smr_t"),
        below("theta_envelope", "theta_t"),
      ]),
      duration: 250 ms
    )
    continuous = sigmoid("smr_envelope" / "smr_t",
                         midpoint: 1.0, steepness: 3)
  }

  output {
    audio_chime = reward.event
    audio_gain  = reward.event.holds ? reward.continuous : 0
  }

  // Voltage controls (units: uV, matching the smoothed envelope output).
  // Defaults are sensible "what would adaptive give you" placeholders; the
  // recorder overwrites them at warmup→run via set_control. Range bounds
  // are wide enough to accommodate clinical variation (electrode-quality
  // differences, individual amplitude variation).
  controls {
    smr_threshold_uv = voltage {
      default      = 2.0 uV
      range        = (0.5 uV, 10.0 uV)
      label        = "SMR threshold"
      live_tunable = true
    }
    theta_threshold_uv = voltage {
      default      = 8.0 uV
      range        = (2.0 uV, 30.0 uV)
      label        = "Theta threshold"
      live_tunable = true
    }
  }

  session {
    phases = [
      // Warmup sized for the baseline-seed handler: it trims to the last
      // 60s of warmup samples (recorder/backend/nf/baseline_seed.py
      // _SETTLED_WINDOW_S = 60.0) to drop sit-down tension, so 90s gives
      // ~30s settling + 60s of clean samples for the seed. The EMG
      // inhibit's 2-min percentile is then ~75% full at run start, which
      // is acceptable: it's an artifact guard, not the feedback driver,
      // and a slightly noisier 95th-pct estimate in the first ~30s of
      // run is benign.
      phase { name = "warmup";   duration = 90 s; output_muted = true },
      phase { name = "training"; duration = 30 min },
      phase { name = "cooldown"; duration = 30 s;  output_muted = true },
    ]
  }
}
