// Alpha uptraining at Pz — BrainBit Flex variant.
//
// Reward when posterior alpha (8-12 Hz) amplitude is above the
// adaptive percentile. Single-band uptrain — the simplest protocol
// in the library and the gentlest first-session experience for new
// users.
//
// Calm-goal protocol. Pairs naturally with high-beta downtraining;
// alpha-up alone is sufficient for a wind-down session.
//
// Electrode placement: scalp channel #1 at Pz (parietal midline,
// the strongest alpha-generator site). Other channels unused.

protocol "alpha_up_pz_brainbit_v1" {

  meta {
    version           = "1.0.0"
    evidence          = "demo"
    description       = "Alpha uptraining at Pz, BrainBit Flex monopolar — Calm-goal lead protocol"
    title             = "Calm the mind — boost alpha (back of head)"
    summary           = "BrainBit: rewards raising relaxed alpha at the back of the head, for calm and lowered anxiety."
    family            = "alpha_up_pz"
    status            = "reviewed"
    goals             = ["calm_anxiety"]
    author            = "Peak Mind"
    citation          = "Hardt J.V. & Kamiya J. (1978). Anxiety change through electroencephalographic alpha feedback. Science, 201(4350), 79-81."
    population        = "children_adults"
    indication        = "calm_anxiety_relaxation"
    control_ref       = "library/alpha_up/sham@1.0"
    safety_monitoring = ["pre_session_check"]
    outcome_measures  = ["subjective_state_report", "STAI"]
  }

  requires {
    coupling    = "ac"
    sample_rate = ">= 250 Hz"
    channels    = ["Pz"]
    impedance   = "not_required"
    markers     = "not_required"
  }

  input "raw" {
    montage = referential(active: "Pz", reference: "device")
  }

  derive "alpha_envelope" {
    from = "raw"
    pipeline = [
      bandpass(band: (8 Hz, 12 Hz), order: 4),
      hilbert(),
      magnitude(),
      smooth(tau: 250 ms),
    ]
  }

  // Adaptive percentile threshold — the user has to perform above their
  // own baseline, not against an absolute target. Reward fires when alpha is
  // above its alpha_reward_pct-th percentile (lower percentile = easier = more
  // reward). This is what makes single-band uptrain feel achievable on the
  // first session.
  threshold "alpha_t" {
    signal       = "alpha_envelope"
    type         = percentile(target_pct: alpha_reward_pct, window: 2 min)
    live_tunable = true
  }

  reward {
    event = dwell(
      condition: above("alpha_envelope", "alpha_t"),
      duration: 250 ms
    )
    continuous = sigmoid("alpha_envelope" / "alpha_t",
                         midpoint: 1.0, steepness: 3)
  }

  output {
    audio_chime = reward.event
    audio_gain  = reward.event.holds ? reward.continuous : 0
  }

  controls {
    alpha_reward_pct = percent {
      default      = 40
      range        = (15, 70)
      label        = "Alpha reward rate"
      live_tunable = true
    }
  }

  session {
    phases = [
      // Warmup matches the percentile window (2 min) so the adaptive
      // threshold buffer is fully baseline-trained at run start. Shorter
      // warmups leave the percentile still settling into the run, which
      // shows up as "garbage threshold" in the first ~30 s.
      phase { name = "warmup";   duration = 120 s; output_muted = true },
      phase { name = "training"; duration = 20 min },
      phase { name = "cooldown"; duration = 30 s;  output_muted = true },
    ]
  }
}
