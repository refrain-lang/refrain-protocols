// SMR up-training over a CLINICIAN-CHOSEN bipolar pair (parameterized
// placement, kind = "bipolar").
//
// The `motor` placement control binds to a 2-tuple (active, reference)
// at resolve time (`bindings={"motor": ("C3","C4")}`) and substitutes
// into a `bipolar(pair: ...)` montage. `allowed` is an inline list of
// permitted pairs.
//
// Already amp-portable: a bipolar montage has no separate `reference` field
// to hardcode, so this file needed no reference edit — only relocation. No
// top-level counterpart (docs/fork-audit-2026-07.md §3).

protocol "placement_smr_bipolar" {

  meta {
    version           = "1.1.0"
    evidence          = "demo"
    description       = "SMR up-training over a clinician-selected bipolar pair (bipolar placement)"
    title             = "SMR training — clinician-chosen bipolar pair"
    summary           = "SMR up-training across a bipolar electrode pair the clinician selects."
    family            = "placement_smr"
    status            = "draft"
    goals             = ["sensorimotor_sleep"]
    author            = "Peak Mind"
    indication        = "sensorimotor_regulation"
    safety_monitoring = ["pre_session_check", "intra_session_clinician_observation"]
  }

  requires {
    coupling    = "ac"
    sample_rate = ">= 250 Hz"
    impedance   = "not_required"
    markers     = "not_required"
  }

  controls {
    motor = placement {
      kind    = "bipolar"
      default = ("C3", "C4")
      allowed = [("C3", "C4"), ("T3", "T4"), ("F3", "F4")]
      label   = "Bipolar motor pair"
    }
    smr_reward_pct = percent {
      default      = 70
      range        = (30, 90)
      label        = "SMR reward rate"
      live_tunable = true
    }
  }

  input "raw" {
    montage = bipolar(pair: motor)
  }

  derive "smr_envelope" {
    from = "raw"
    pipeline = [
      bandpass(band: (12 Hz, 15 Hz), order: 4),
      hilbert(),
      magnitude(),
      smooth(tau: 250 ms),
    ]
  }

  threshold "smr_t" {
    signal       = "smr_envelope"
    type         = percentile(target_pct: smr_reward_pct, window: 2 min)
    live_tunable = true
  }

  reward {
    event = dwell(
      condition: all_of([above("smr_envelope", "smr_t")]),
      duration: 250 ms
    )
    continuous = sigmoid("smr_envelope" / "smr_t", midpoint: 1.0, steepness: 3)
  }

  output {
    audio_chime = reward.event
    audio_gain  = reward.event.holds ? reward.continuous : 0
  }

  session {
    phases = [
      // Warmup matches the percentile window (2 min) so the adaptive
      // threshold buffer is fully baseline-trained at run start. Shorter
      // warmups leave the percentile still settling into the run, which
      // shows up as "garbage threshold" in the first ~30 s.
      phase { name = "warmup";   duration = 120 s; output_muted = true },
      phase { name = "training"; duration = 20 min },
      phase { name = "cooldown"; duration = 30 s;  output_muted = true },
    ]
  }
}
