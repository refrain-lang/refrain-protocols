// Narrow-band alpha/theta crossover, adapted from the feedback structure
// documented in Brain-Trainer's ALP1C design. This is a separate draft from
// alpha_theta.refrain: it compares 6-8 Hz theta with 9-11 Hz alpha directly,
// without an additional theta percentile gate or a sub-crossover shaping
// target. The live reward-ratio control defaults to strict crossover (1.00)
// and can be lowered to shape toward it without changing the separately
// reported literal theta-over-alpha statistic. A gong marks entry after one
// second; audio_gain remains present while the reward target holds.

protocol "alpha_theta_narrowband" {

  meta {
    version         = "1.2.0"
    evidence        = "exploratory"
    description     = "Narrow-band 6-8 Hz theta/9-11 Hz alpha feedback with a live ratio target, continuous hold feedback, and slow/fast guards"
    title           = "Alpha/theta crossover — narrow-band continuous feedback"
    summary         = "Eyes-closed posterior training with a live reward-ratio target that defaults to strict theta-over-alpha crossover."
    family          = "alpha_theta"
    threshold_style = "adaptive"
    status          = "draft"
    modality        = "eeg"
    goals           = ["deep_meditative"]
    author          = "Peak Mind"
    citation        = "Brain-Trainer Designs Manual, ALP1C Alpha Theta, pp. 12-13 (2020); Peniston & Kulkosky 1989, 1991"
    control_ref     = "library/operant/alpha_theta_sham@1.0"
    advanced_controls = [
      "site",
      "theta_lo_hz", "theta_hi_hz",
      "alpha_lo_hz", "alpha_hi_hz",
      "slow_guard", "slow_inhibit_rate",
      "fast_guard", "fast_inhibit_rate",
    ]
  }

  requires {
    coupling    = "ac"
    sample_rate = ">= 250 Hz"
    impedance   = "not_required"
    markers     = "not_required"
  }

  input "raw" {
    montage = referential(active: site, reference: amp.reference)
  }

  derive "slow_envelope" {
    from = "raw"
    pipeline = [
      bandpass(band: (3 Hz, 5 Hz), order: 4),
      hilbert(),
      magnitude(),
      smooth(tau: 500 ms),
    ]
  }

  derive "theta_envelope" {
    from = "raw"
    pipeline = [
      bandpass(band: (theta_lo_hz, theta_hi_hz), order: 4),
      hilbert(),
      magnitude(),
      smooth(tau: 500 ms),
    ]
  }

  derive "alpha_envelope" {
    from = "raw"
    pipeline = [
      bandpass(band: (alpha_lo_hz, alpha_hi_hz), order: 4),
      hilbert(),
      magnitude(),
      smooth(tau: 500 ms),
    ]
  }

  derive "fast_envelope" {
    from = "raw"
    pipeline = [
      bandpass(band: (15 Hz, 56 Hz), order: 4),
      hilbert(),
      magnitude(),
      smooth(tau: 250 ms),
    ]
  }

  derive "theta_alpha_ratio" {
    formula = "theta_envelope" / "alpha_envelope"
  }

  inhibit "slow" {
    metric    = bandpower(input: "raw", band: (3 Hz, 5 Hz), window: 2 s)
    threshold = percentile(
      target_pct: slow_guard == "on" ? slow_inhibit_rate : 100,
      window: 2 min
    )
    action    = mute(release: 1 s)
  }

  inhibit "fast" {
    metric    = bandpower(input: "raw", band: (15 Hz, 56 Hz), window: 250 ms)
    threshold = percentile(
      target_pct: fast_guard == "on" ? fast_inhibit_rate : 100,
      window: 2 min
    )
    action    = mute(release: 500 ms)
  }

  reward {
    event = dwell(
      condition: all_of([
        above("theta_alpha_ratio", reward_ratio_target) as "reward target",
      ]),
      duration: 1000 ms
    )
    continuous = sigmoid("theta_alpha_ratio", midpoint: 1.0, steepness: 4)
  }

  output {
    audio_gain  = reward.event.holds ? reward.continuous : 0
    audio_chime = reward.event
  }

  controls {
    reward_ratio_target = number {
      default      = 1.00
      range        = (0.70, 1.05)
      label        = "Reward ratio target (1.00 = theta over alpha)"
      live_tunable = true
    }
    site = placement {
      kind    = "active"
      default = "Pz"
      label   = "Training site"
    }
    theta_lo_hz = frequency {
      default      = 6 Hz
      range        = (4 Hz, 7 Hz)
      label        = "Theta band low edge"
      live_tunable = false
    }
    theta_hi_hz = frequency {
      default      = 8 Hz
      range        = (7 Hz, 9 Hz)
      label        = "Theta band high edge"
      live_tunable = false
    }
    alpha_lo_hz = frequency {
      default      = 9 Hz
      range        = (8 Hz, 11 Hz)
      label        = "Alpha band low edge"
      live_tunable = false
    }
    alpha_hi_hz = frequency {
      default      = 11 Hz
      range        = (10 Hz, 13 Hz)
      label        = "Alpha band high edge"
      live_tunable = false
    }
    slow_guard = mode {
      choices = ["on", "off"]
      default = "on"
      label   = "Slow-wave guard"
    }
    slow_inhibit_rate = percent {
      default      = 95
      range        = (75, 99)
      label        = "Slow-wave inhibit threshold"
      live_tunable = true
    }
    fast_guard = mode {
      choices = ["on", "off"]
      default = "on"
      label   = "Fast-activity guard"
    }
    fast_inhibit_rate = percent {
      default      = 95
      range        = (75, 99)
      label        = "Fast-activity inhibit threshold"
      live_tunable = true
    }
  }

  session {
    phases = [
      phase { name = "settle";   duration = 2 min;  output_muted = true },
      phase { name = "deep1";    duration = 15 min; mode = timed_with_floor },
      phase { name = "rest1";    duration = 2 min;  output_muted = true },
      phase { name = "deep2";    duration = 15 min; mode = timed_with_floor },
      phase { name = "cooldown"; duration = 2 min;  output_muted = true },
    ]
  }
}
