// High-beta downtraining at Cz — BrainBit Flex variant.
//
// Reward when high-beta (22-30 Hz) amplitude is BELOW the adaptive
// percentile — i.e., the user is rewarded for quieting the band
// associated with rumination, worry, and over-arousal.
//
// Calm-goal protocol. Pairs naturally with alpha-up at Pz: alpha-up
// trains positive presence of a calm rhythm, high-beta-down trains
// absence of a stress rhythm. Two complementary mechanisms.
//
// Electrode placement: scalp channel #1 at Cz. Other channels unused.
//
// RETIRED: superseded by protocols/eeg/hibeta_down_cz.refrain, which already
// read a live amp-reference montage and had the mode toggle/seed/staged
// session this file lacked. Kept runnable for subjects already assigned it;
// hidden from the default picker.

protocol "high_beta_down_cz_brainbit_v1" {

  meta {
    version           = "1.0.0"
    evidence          = "demo"
    description       = "High-beta (22-30 Hz) downtraining at Cz, BrainBit Flex monopolar"
    title             = "Ease over-arousal — quiet high-beta (top of head)"
    summary           = "BrainBit: rewards lowering fast high-beta activity linked to anxiety and rumination."
    family            = "hibeta_down_cz"
    status            = "legacy"
    goals             = ["calm_anxiety"]
    author            = "Peak Mind"
    citation          = "Hammond D.C. (2005). Neurofeedback treatment of depression and anxiety. Journal of Adult Development, 12(2-3), 131-137."
    population        = "adults_18_plus"
    indication        = "anxiety_rumination_overarousal"
    control_ref       = "library/high_beta_down/sham@1.0"
    safety_monitoring = ["pre_session_check"]
    outcome_measures  = ["subjective_state_report", "STAI"]
  }

  requires {
    coupling    = "ac"
    sample_rate = ">= 250 Hz"
    channels    = ["Cz"]
    impedance   = "not_required"
    markers     = "not_required"
  }

  input "raw" {
    montage = referential(active: "Cz", reference: "device")
  }

  derive "hbeta_envelope" {
    from = "raw"
    pipeline = [
      bandpass(band: (22 Hz, 30 Hz), order: 4),
      hilbert(),
      magnitude(),
      smooth(tau: 250 ms),
    ]
  }

  // Adaptive threshold driven by the reward-rate control: reward fires
  // while high-beta stays in the lowest `hbeta_reward_rate` % of its own
  // recent distribution, so a higher rate = more time below threshold.
  threshold "hbeta_t" {
    signal       = "hbeta_envelope"
    type         = percentile(target_pct: hbeta_reward_rate, window: 2 min)
    live_tunable = true
  }

  reward {
    event = dwell(
      condition: below("hbeta_envelope", "hbeta_t"),
      duration: 250 ms
    )
    // Continuous reward grows as high-beta sinks below threshold.
    // We invert the ratio so the sigmoid maps "smaller = larger reward".
    continuous = sigmoid("hbeta_t" / "hbeta_envelope",
                         midpoint: 1.0, steepness: 3)
  }

  output {
    audio_chime = reward.event
    audio_gain  = reward.event.holds ? reward.continuous : 0
  }

  controls {
    hbeta_reward_rate = percent {
      default      = 60
      range        = (30, 85)
      label        = "High-beta reward rate"
      live_tunable = true
    }
  }

  session {
    phases = [
      // Warmup matches the percentile window (2 min) so the adaptive
      // threshold buffer is fully baseline-trained at run start. Shorter
      // warmups leave the percentile still settling into the run, which
      // shows up as "garbage threshold" in the first ~30 s.
      phase { name = "warmup";   duration = 120 s; output_muted = true },
      phase { name = "training"; duration = 20 min },
      phase { name = "cooldown"; duration = 30 s;  output_muted = true },
    ]
  }
}
