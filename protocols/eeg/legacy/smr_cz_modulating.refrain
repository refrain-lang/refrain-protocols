// RETIRED: uses continuous ambient audio_gain modulation as the operant
// signal itself, rather than a discrete chime — a feedback mode the
// clinical library no longer differentiates as a separate protocol.
// Kept runnable for subjects already assigned it; hidden from the default picker.
// SMR / theta-beta operant training at Cz — continuously-modulating
// output variant.
//
// Same math + thresholds as `smr_classic_cz.refrain` — the only
// difference is the audio_gain output binding: ungated by event.holds
// so the analog reward signal is a smooth function of SMR/threshold
// ratio at all times, not just during dwell-active windows.
//
// Intended for hosts that map audio_gain onto an ambient feedback
// channel (system-volume modulation of patient-chosen media, screen-
// dimming overlay, etc.) where continuous modulation IS the operant
// signal and the discrete dwell event is informational-only.
//
// Amp-portable (2026-07): reads amp.reference instead of a hardcoded
// "device" reference, so one file resolves on both a clinical amp and a
// consumer amp. No top-level counterpart (docs/fork-audit-2026-07.md §3) —
// one of the four deliberately differentiated "smr_cz" family protocols.

protocol "smr_cz_modulating" {

  meta {
    version           = "1.1.0"
    evidence          = "demo"
    description       = "SMR/theta-beta operant training at Cz"
    title             = "Classic SMR training — ambient feedback (top of head)"
    summary           = "SMR operant at the top of the head with continuous ambient (modulating) audio feedback."
    family            = "smr_cz"
    status            = "legacy"
    goals             = ["adhd_attention"]
    author            = "Peak Mind"
    citation          = "Sterman M.B. & Lubar J.F. (foundational corpus, 1970s-1990s)"
    population        = "children_adults"
    indication        = "ADHD_attention_regulation"
    control_ref       = "library/operant/smr_sham@1.0"
    safety_monitoring = ["pre_session_check", "intra_session_clinician_observation"]
    outcome_measures  = ["IVA-2_continuous_performance", "Conners-3"]
  }

  requires {
    coupling    = "ac"
    sample_rate = ">= 250 Hz"
    channels    = ["Cz"]
    impedance   = "not_required"
    markers     = "not_required"
  }

  // Monopolar Cz — reference resolves per the connected amp's profile.
  input "raw" {
    montage = referential(active: "Cz", reference: amp.reference)
  }

  derive "smr_envelope" {
    from = "raw"
    pipeline = [
      bandpass(band: (12 Hz, 15 Hz), order: 4),
      hilbert(),
      magnitude(),
      smooth(tau: 250 ms),
    ]
  }

  derive "theta_envelope" {
    from = "raw"
    pipeline = [
      bandpass(band: (4 Hz, 8 Hz), order: 4),
      hilbert(),
      magnitude(),
      smooth(tau: 250 ms),
    ]
  }

  derive "high_beta_envelope" {
    from = "raw"
    pipeline = [
      bandpass(band: (22 Hz, 30 Hz), order: 4),
      hilbert(),
      magnitude(),
      smooth(tau: 250 ms),
    ]
  }

  // Adaptive thresholds. The SMR reward threshold is a direct percentile of
  // the trainee's own signal — reward fires when SMR is above its
  // smr_reward_pct-th percentile (lower percentile = easier = more reward).
  // The inhibit thresholds are wired to their rate controls below.
  threshold "smr_t" {
    signal       = "smr_envelope"
    type         = percentile(target_pct: smr_reward_pct, window: 2 min)
    live_tunable = true
  }

  threshold "theta_t" {
    signal       = "theta_envelope"
    type         = percentile(target_pct: theta_inhibit_rate, window: 2 min)
    live_tunable = true
  }

  threshold "hbeta_t" {
    signal       = "high_beta_envelope"
    type         = percentile(target_pct: hbeta_inhibit_rate, window: 2 min)
    live_tunable = true
  }

  reward {
    event = dwell(
      condition: all_of([
        above("smr_envelope",       "smr_t"),
        below("theta_envelope",     "theta_t"),
        below("high_beta_envelope", "hbeta_t"),
      ]),
      duration: 250 ms
    )
    continuous = sigmoid("smr_envelope" / "smr_t",
                         midpoint: 1.0, steepness: 3)
  }

  output {
    audio_chime = reward.event
    audio_gain  = reward.continuous
  }

  controls {
    smr_reward_pct = percent {
      default      = 40
      range        = (15, 70)
      label        = "SMR reward rate"
      live_tunable = true
    }
    theta_inhibit_rate = percent {
      default      = 75
      range        = (50, 95)
      label        = "Theta inhibit rate"
      live_tunable = true
    }
    hbeta_inhibit_rate = percent {
      default      = 75
      range        = (50, 95)
      label        = "High-beta inhibit rate"
      live_tunable = true
    }
  }

  session {
    phases = [
      // Warmup matches the percentile window (2 min) so the adaptive
      // threshold buffer is fully baseline-trained at run start. Shorter
      // warmups leave the percentile still settling into the run, which
      // shows up as "garbage threshold" in the first ~30 s.
      phase { name = "warmup";   duration = 120 s; output_muted = true },
      phase { name = "training"; duration = 30 min },
      phase { name = "cooldown"; duration = 30 s;  output_muted = true },
    ]
  }
}
