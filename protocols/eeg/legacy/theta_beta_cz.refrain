// theta_beta_cz.refrain  —  DRAFT (status=draft, untested)
// BETA/THETA up-train at Cz.  Lubar (theta/beta)
//
// RETIRED: superseded by protocols/eeg/beta_attention.refrain — despite the
// name/bands list, this is a single-band envelope (no theta component, no
// ratio computed); set the site to Cz (the trained band, ~15-18 Hz, already
// matches the template's default lo-beta band). Kept runnable for subjects
// already assigned it; hidden from the default picker.
protocol "theta_beta_cz" {
  meta {
    version         = "0.1.0"
    title           = "Sharpen attention — beta up over theta (top of head)"
    summary         = "Trains focused beta up relative to daydreamy theta at the top of the head."
    family          = "theta_beta_cz"
    description     = "BETA/THETA up-train at Cz"
    status          = "legacy"
    evidence        = "established"
    citation        = "Lubar (theta/beta)"
    goals           = ["adhd_attention"]
    bands           = ["beta", "theta"]
    site            = "Cz"
    direction       = "up"
    threshold_style = "selectable"
    feedback_style  = "discrete"
    session_shape   = "staged"
  }

  requires {
    sample_rate = ">= 250 Hz"
    channels    = ["Cz"]
  }

  input "raw" { montage = referential(active: "Cz", reference: amp.reference) }

  derive "env" {
    from = "raw"
    pipeline = [
      bandpass(center: env_center, bandwidth: ratio(1.2), order: 4),
      hilbert(),
      magnitude(),
      smooth(tau: 250 ms),
    ]
  }

  threshold "env_t" {
    signal = "env"
    type = threshold_style == "baseline"
             ? absolute(value: thr_uv)
             : percentile(target_pct: reward_pct, window: 2 min)
    live_tunable = true
  }

  reward {
    event      = dwell(condition: above("env", "env_t"), duration: 250 ms)
    continuous = sigmoid("env" / "env_t", midpoint: 1.0, steepness: 3)
  }

  output {
    audio_chime = reward.event
    audio_gain  = reward.event.holds ? reward.continuous : 0
  }

  controls {
    threshold_style = mode {
      choices = ["adaptive", "baseline"]
      default = "adaptive"
      label   = "Threshold style"
    }
    env_center = frequency {
      default = 16.4317 Hz
      range   = (13.15 Hz, 19.72 Hz)
      label   = "BETA/THETA band center"
    }
    reward_pct = percent {
      default      = 70
      range        = (50, 90)
      label        = "Target reward %"
      live_tunable = true
    }
    thr_uv = voltage {
      default      = 2.0 uV
      range        = (0.5 uV, 30.0 uV)
      label        = "Threshold (baseline-seeded)"
      live_tunable = true
      seed = percentile {
        from       = "env"
        window     = 60 s
        target_pct = reward_pct
      }
    }
  }
  // Default: 4x5-min blocks with 2-min rests on one baseline (host overrides
  // block_minutes / block_count by sending a different phase list).
  session {
    phases = [
      phase { name = "warmup";   duration = 90 s;  output_muted = true },
      phase { name = "block1";   duration = 5 min; mode = timed_with_floor },
      phase { name = "rest1";    duration = 2 min; output_muted = true },
      phase { name = "block2";   duration = 5 min; mode = timed_with_floor },
      phase { name = "rest2";    duration = 2 min; output_muted = true },
      phase { name = "block3";   duration = 5 min; mode = timed_with_floor },
      phase { name = "rest3";    duration = 2 min; output_muted = true },
      phase { name = "block4";   duration = 5 min; mode = timed_with_floor },
      phase { name = "cooldown"; duration = 30 s;  output_muted = true },
    ]
  }
}
