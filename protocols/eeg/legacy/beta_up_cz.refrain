// Beta uptraining at Cz.
//
// Focus-goal alternative to the smr_cz family (e.g. smr_classic_cz.refrain).
// Same shape, more activating band: reward beta1 (15-20 Hz) above percentile
// AND theta (4-8 Hz) below — without the SMR component. Suited to
// "engaged work" sessions where the user wants alertness, not just
// calm focus.
//
// Electrode placement: scalp channel #1 at Cz. Other channels unused.
//
// NOT a merge with theta_beta_cz.refrain: per docs/fork-audit-2026-07.md §2.8
// (Finding F7), this file's own meta.family ("beta_up_cz") doesn't match any
// top-level file, and theta_beta_cz.refrain is a single-band envelope with no
// theta component despite its name/bands list — the audit flagged the
// pairing as uncertain and declined to merge. This is a distinct three-band
// operant protocol (beta up, theta inhibit, high-beta inhibit); a forthcoming
// configurable Beta-attention template is expected to reproduce it by
// configuration, at which point it can be retired.
//
// Amp-portable (2026-07): reads amp.reference instead of a hardcoded
// "device" reference, so one file resolves on both a clinical amp and a
// consumer amp.
//
// RETIRED: superseded by protocols/eeg/beta_attention.refrain — the
// forthcoming configurable Beta-attention template predicted above has now
// shipped; set the band to 15-20 Hz and the site to Cz. Kept runnable for
// subjects already assigned it; hidden from the default picker.

protocol "beta_up_cz" {

  meta {
    version           = "1.1.0"
    evidence          = "demo"
    description       = "Beta1 (15-20 Hz) uptraining at Cz with theta inhibit"
    title             = "Alert focus — boost beta (top of head)"
    summary           = "Rewards raising engaged beta with a theta inhibit at the top of the head."
    family            = "beta_up_cz"
    status            = "legacy"
    goals             = ["alertness_performance"]
    author            = "Peak Mind"
    citation          = "Egner T. & Gruzelier J.H. (2004). EEG biofeedback of low beta band components: frequency-specific effects on variables of attention and event-related brain potentials. Clinical Neurophysiology, 115(1), 131-139."
    population        = "adults_18_plus"
    indication        = "attention_alertness_performance"
    control_ref       = "library/beta_up/sham@1.0"
    safety_monitoring = ["pre_session_check"]
    outcome_measures  = ["subjective_state_report"]
  }

  requires {
    coupling    = "ac"
    sample_rate = ">= 250 Hz"
    channels    = ["Cz"]
    impedance   = "not_required"
    markers     = "not_required"
  }

  input "raw" {
    montage = referential(active: "Cz", reference: amp.reference)
  }

  derive "beta_envelope" {
    from = "raw"
    pipeline = [
      bandpass(band: (15 Hz, 20 Hz), order: 4),
      hilbert(),
      magnitude(),
      smooth(tau: 250 ms),
    ]
  }

  derive "theta_envelope" {
    from = "raw"
    pipeline = [
      bandpass(band: (4 Hz, 8 Hz), order: 4),
      hilbert(),
      magnitude(),
      smooth(tau: 250 ms),
    ]
  }

  // High-beta artifact guard — beta uptrain is vulnerable to EMG
  // contamination because muscle activity shows up in 20-30 Hz too.
  // An absolute hbeta ceiling prevents the user from being rewarded
  // for jaw clench.
  derive "high_beta_envelope" {
    from = "raw"
    pipeline = [
      bandpass(band: (22 Hz, 30 Hz), order: 4),
      hilbert(),
      magnitude(),
      smooth(tau: 250 ms),
    ]
  }

  // Adaptive percentile threshold of the trainee's own signal — reward fires
  // when beta is above its beta_reward_pct-th percentile (lower percentile =
  // easier = more reward). The window provides the auto-recalibration.
  threshold "beta_t" {
    signal       = "beta_envelope"
    type         = percentile(target_pct: beta_reward_pct, window: 2 min)
    live_tunable = true
  }

  threshold "theta_t" {
    signal       = "theta_envelope"
    type         = percentile(target_pct: theta_inhibit_rate, window: 2 min)
    live_tunable = true
  }

  threshold "hbeta_t" {
    signal       = "high_beta_envelope"
    type         = percentile(target_pct: hbeta_inhibit_rate, window: 2 min)
    live_tunable = true
  }

  reward {
    event = dwell(
      condition: all_of([
        above("beta_envelope",       "beta_t"),
        below("theta_envelope",      "theta_t"),
        below("high_beta_envelope",  "hbeta_t"),
      ]),
      duration: 250 ms
    )
    continuous = sigmoid("beta_envelope" / "beta_t",
                         midpoint: 1.0, steepness: 3)
  }

  output {
    audio_chime = reward.event
    audio_gain  = reward.event.holds ? reward.continuous : 0
  }

  controls {
    beta_reward_pct = percent {
      default      = 40
      range        = (15, 70)
      label        = "Beta reward rate"
      live_tunable = true
    }
    theta_inhibit_rate = percent {
      default      = 75
      range        = (50, 95)
      label        = "Theta inhibit rate"
      live_tunable = true
    }
    hbeta_inhibit_rate = percent {
      default      = 75
      range        = (50, 95)
      label        = "High-beta inhibit rate"
      live_tunable = true
    }
  }

  session {
    phases = [
      // Warmup matches the percentile window (2 min) so the adaptive
      // threshold buffer is fully baseline-trained at run start. Shorter
      // warmups leave the percentile still settling into the run, which
      // shows up as "garbage threshold" in the first ~30 s.
      phase { name = "warmup";   duration = 120 s; output_muted = true },
      phase { name = "training"; duration = 25 min },
      phase { name = "cooldown"; duration = 30 s;  output_muted = true },
    ]
  }
}
